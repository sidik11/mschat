{
  "rewrites": [
    {
      "source": "/api/((?!index(?:/|$)).*)",
      "destination": "/api/index?route=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 3 * * *"
    }
  ]
}
