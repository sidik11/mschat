# MS Chat environment variable template
# Copy to .env for local development. For Vercel, add ONLY real values
# in Project Settings -> Environment Variables. These placeholders do not work.
# Never use VITE_ prefixes for server secrets.

NODE_ENV=development
APP_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Firebase Admin SDK (server-only; required only when Firebase routes are enabled)
FIREBASE_DATABASE_URL=https://YOUR_FIREBASE_PROJECT-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=YOUR_SERVICE_ACCOUNT_EMAIL
# Paste the actual service-account private key, preserving newline escaping as needed.
FIREBASE_PRIVATE_KEY=REPLACE_WITH_REAL_PRIVATE_KEY

# Session security (not used until secure sessions are implemented)
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
SESSION_TTL_SECONDS=2592000

# Gmail API OAuth (planned; not currently used by the auth endpoints)
GMAIL_CLIENT_ID=REPLACE_LATER
GMAIL_CLIENT_SECRET=REPLACE_LATER
GMAIL_REFRESH_TOKEN=REPLACE_LATER
GMAIL_SENDER_EMAIL=REPLACE_LATER

# Cloudflare R2 (planned; not currently used by transfer endpoints)
R2_ACCOUNT_ID=REPLACE_LATER
R2_ACCESS_KEY_ID=REPLACE_LATER
R2_SECRET_ACCESS_KEY=REPLACE_LATER
R2_BUCKET_NAME=REPLACE_LATER
R2_PUBLIC_BASE_URL=REPLACE_LATER

# Web Push (planned; not currently used by notification endpoints)
VAPID_PUBLIC_KEY=REPLACE_LATER
VAPID_PRIVATE_KEY=REPLACE_LATER
VAPID_SUBJECT=mailto:admin@example.com

# Admin bootstrap (planned; keep unset until a secure bootstrap flow exists)
ADMIN_BOOTSTRAP_SECRET=REPLACE_LATER
