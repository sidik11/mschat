# Public application settings
NODE_ENV=development
APP_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Firebase Admin SDK (server only)
FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_CLIENT_EMAIL=service-account@YOUR_PROJECT.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_REAL_KEY\n-----END PRIVATE KEY-----\n"

# Session security — generate a long random secret before deployment
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
SESSION_TTL_SECONDS=2592000

# Gmail API OAuth credentials (server only)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Cloudflare R2 (private bucket; server only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Web Push — private key must never use a VITE_ prefix
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Set once during secure first-admin bootstrap; do not reuse a normal user password
ADMIN_BOOTSTRAP_SECRET=